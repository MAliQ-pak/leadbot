# Copy to .env (or export these) before running.
# Which AI writes replies: claude (Anthropic, paid) or gemini (Google, has a free tier).
# No key for the chosen provider = offline rule-based bot.
LLM_PROVIDER=claude
# Google AI Studio key (aistudio.google.com). Free tier: Google may use the content to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded or out of free quota (comma-separated)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest
# Leave ANTHROPIC_API_KEY empty to run in MOCK mode (no LLM, rule-based replies) for offline demos.
ANTHROPIC_API_KEY=
# Only needed if your API key is not tied to a workspace (the API then asks for one). Find the ID in console.anthropic.com > Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=
MODEL=claude-sonnet-5-5
# CRM sync is OFF by default: leads are managed in each owner's dashboard (/app). Set true to also push warm/hot leads to a CRM.
CRM_ENABLED=false
# Optional (only used when CRM_ENABLED=true): GoHighLevel inbound webhook or any CRM webhook. Empty = mock CRM (writes crm_mock.jsonl)
CRM_WEBHOOK_URL=
# Weight of the trained classifier in the final lead score (0 = rules only, 1 = model only)
ML_WEIGHT=0.5
# Database. Empty = SQLite file leadbot.db (no setup). For the live site, a PostgreSQL URL, e.g. from neon.tech:
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require   (never commit the real one)
DATABASE_URL=
# Signs the owners' login cookies. Empty on a laptop = a random key kept in .secret_key. Set a long random value on a server.
SECRET_KEY=
# Claude spending guards for a public site (beyond these the offline bot answers)
LLM_HOURLY_LIMIT=200
MAX_CLAUDE_MESSAGES_PER_CHAT=30
# Fill an empty database with the two fictional demo businesses at start-up (presentations only)
SEED_DEMO=false
# Password of the demo owner accounts. Empty on a laptop = leadbot-demo; empty on Render = random each start.
DEMO_PASSWORD=
